{
  "manifest_version": 3,
  "name": "Undistract",
  "version": "1.0.0",
  "description": "Dont let the algorithms win.",

  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.reddit.com/*",
        "https://www.hulu.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "*://*.netflix.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"]
}
